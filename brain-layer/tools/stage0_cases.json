  "command_notes": {
    "where_is_it": "{\"target\": ref} -- tell the pilot where that one contact is (bearing and range are rendered for you)",
    "follow": "{\"target\": ref} -- keep an eye on that one contact (\"keep an eye on\", \"watch that\", \"track\")",
    "select_target": "{\"target\": ref} -- make that contact the selected target",
    "mark_target": "{\"target\": ref} -- remember that contact's position as a mark",
    "drop_target": "no target -- forget the selected target",
    "mark_here": "no target -- remember our own position as a mark",
    "watch_nearest": "no target -- watch whichever contact is nearest",
    "watch_nearest_air_defence": "no target -- watch the nearest air-defence contact",
    "report": "no target -- a general contact report",
    "report_all": "no target -- report every contact",
    "cancel_task": "no target -- stop whatever task is running",
    "cancel_scan": "no target -- stop scanning",
    "cancel_watch": "no target -- stop watching"
  },
