{
  "_comment": "Acceptance fixture for plans/brain-tool-calls/plan.md Stage 0 (brain-layer/tools/stage0_tool_call_probe.py). One case per bullet of the plan's 'Acceptance set (A1 categories)' section. `tools` and `commands` are shared across every case (D5: the same 7 query tools and the same BRAIN_COMMANDS allowlist are offered on every turn). No raw x/z coordinates anywhere in this file, per D2 -- positions are clock/range/landmark text only.",
  "tools": [
    {
      "name": "find_contact",
      "description": "Find a contact matching a short description (class, colloquial name, or landmark).",
      "params": [
        {
          "name": "text",
          "kind": "str",
          "required": true,
          "max_len": 40
        }
      ]
    },
    {
      "name": "list_contacts",
      "description": "List known contacts, optionally filtered by class, place or freshness.",
      "params": [
        {
          "name": "filter",
          "kind": "str",
          "required": false,
          "max_len": 40
        }
      ]
    },
    {
      "name": "describe_contact",
      "description": "Describe one already-offered contact in detail: class, group, motion, nearest landmark.",
      "params": [
        {
          "name": "contact_ref",
          "kind": "contact_ref",
          "required": true
        }
      ]
    },
    {
      "name": "get_contact_history",
      "description": "When an already-offered contact was last observed.",
      "params": [
        {
          "name": "contact_ref",
          "kind": "contact_ref",
          "required": true
        }
      ]
    },
    {
      "name": "find_place",
      "description": "Find a named place (settlement, landmark) on the map.",
      "params": [
        {
          "name": "text",
          "kind": "str",
          "required": true,
          "max_len": 40
        }
      ]
    },
    {
      "name": "describe_our_position",
      "description": "Where ownship currently is, in clock/range/landmark terms.",
      "params": []
    },
    {
      "name": "recall_memory",
      "description": "Recall pilot-marked locations (mission memory), optionally filtered by kind or nearness to a place or to ownship.",
      "params": [
        {
          "name": "kind",
          "kind": "str",
          "required": false,
          "max_len": 40
        },
        {
          "name": "near",
          "kind": "str",
          "required": false,
          "max_len": 40
        },
        {
          "name": "include_struck",
          "kind": "bool",
          "required": false
        }
      ]
    }
  ],
