# Dropbox-synced scratch channel between Mac and Windows DCS machine —
# not part of this repo. See world-model/WORKFLOW.md.
/win-mac-sync

# skill canditates, not worth tracking in repo
.claude/agent-memory/skill-candidates.md

# Third-party .miz sample missions -- real DCS mission files used for
# mission-interpreter development/testing, not licensed for redistribution
# (community campaign content, community-tool assets, etc.). Local-only.
mission-interpreter/research/samples/


# Knowledge-graph build artifacts and the curated corpus mirror they are
# built from. Both are derived; the corpus is a copy of tracked documents.
graphify-corpus/
graphify-out/

# Saved-page asset directories (browser "Web Page, complete") -- the HTML
# itself is committed as provenance; its styling/scripts are not.
*_files/

# Per-context markers written by .claude/scripts/session-start.sh (one file per
# session id, swept after 12h). Local session state, not project state.
.claude/state/sessions/
.claude/state/

# Obsidian vault configuration -- per-user, and workspace.json rewrites on every
# pane move. Unanchored so it matches at any depth: a nested .obsidian/ makes a
# half-working vault that resolves links within one subproject only. The vault
# is rooted at the repo root; see docs/DOC_CONVENTIONS.md.
.obsidian/

# Mac Finder-app options
.DS_Store

# Python bytecode cache -- generated wherever a .claude/scripts/*.py is run directly
# (doc_provenance.py, doc_tags.py, ...), never worth tracking.
__pycache__/
